# Installed Odoo addons only.
{% for rel in module_paths %}
{% for parent in parents(rel) %}
!{{ parent }}/
{% endfor %}
!{{ rel }}/**/
{% for glob in source_globs %}
!{{ rel }}/**/{{ glob }}
{% endfor %}
{% endfor %}

