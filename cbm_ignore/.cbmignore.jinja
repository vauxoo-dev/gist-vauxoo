# Generated from installed Odoo modules.
# Keep repo_path=/home/odoo/instance and project name stable.

*

# Odoo core package. Keep it complete for ORM/http/sql/api internals.
{% for rel in core_dirs %}
{% for parent in parents(rel) %}
!{{ parent }}/
{% endfor %}
!{{ rel }}/**/
{% for glob in source_globs %}
!{{ rel }}/**/{{ glob }}
{% endfor %}
{% endfor %}

# Drop Odoo test addon modules, but keep unittest folders inside real installed modules.
odoo/odoo/addons/test_*/
